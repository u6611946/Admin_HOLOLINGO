rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // ADMIN ROLE HELPERS (from the admin dashboard's rules — merged
    // in here since Firestore only has one active ruleset per project;
    // the app and the admin dashboard share this same file).
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function hasAdminAccount() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminRole() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role;
    }

    // Any signed-in admin-panel account (super_admin, admin, or viewer).
    function isPanelUser() {
      return hasAdminAccount() && adminRole() in ['super_admin', 'admin', 'viewer'];
    }

    // Can manage app content (users, scans, announcements, events) but not other admins or settings.
    function isModerator() {
      return hasAdminAccount() && adminRole() in ['super_admin', 'admin'];
    }

    // Full access: manage other admins and app-wide settings.
    function isSuperAdmin() {
      return hasAdminAccount() && adminRole() == 'super_admin';
    }

    // ============================================================
    // DAILY CHALLENGE HELPERS
    //
    // Event-scoped, admin-curated, matchmade 10-round battles wagering
    // tokens — the app's only wager mode. No Cloud Function refereeing
    // this (Spark plan, no billing account), so the winner and the token
    // transfer are both validated here instead of by a trusted backend.
    // ============================================================

    function dailyBattleParticipant(battleId) {
      let battle = get(/databases/$(database)/documents/daily_battles/$(battleId)).data;
      return request.auth.uid == battle.player_a_uid || request.auth.uid == battle.player_b_uid;
    }

    // A round can only be created holding the EXACT options/correct_index
    // the admin set for the word at its claimed source_index that day —
    // never whatever a client making the battle would prefer — since both
    // players share this one set of rounds. source_index (not the round's
    // own sequential index) is what it's checked against, since each
    // match randomly draws its rounds from that day's whole word pool.
    function dailyRoundMatchesSource(battleId) {
      let battle = get(/databases/$(database)/documents/daily_battles/$(battleId)).data;
      let sourceIndex = request.resource.data.source_index;
      let source = get(/databases/$(database)/documents/events/$(battle.event_id)/daily_challenges/$(battle.challenge_date)/words/$(sourceIndex)).data;
      return request.resource.data.options == source.options
        && request.resource.data.correct_index == source.correct_index;
    }

    function dailyBattleExpectedResult(scoreA, scoreB) {
      return scoreA == scoreB ? 'draw' : (scoreA > scoreB ? 'player_a' : 'player_b');
    }

    function isValidDailySettlement(userId) {
      let battleId = request.resource.data.get('last_daily_settlement', null);
      return battleId != null && isValidDailySettlementFor(userId, battleId);
    }

    function isValidDailySettlementFor(userId, battleId) {
      let battle = get(/databases/$(database)/documents/daily_battles/$(battleId)).data;
      let requesterIsParticipant = request.auth.uid == battle.player_a_uid || request.auth.uid == battle.player_b_uid;
      let targetIsParticipant = userId == battle.player_a_uid || userId == battle.player_b_uid;
      let isWinner = (battle.result == 'player_a' && userId == battle.player_a_uid)
        || (battle.result == 'player_b' && userId == battle.player_b_uid);
      let isLoser = targetIsParticipant && !isWinner && battle.result != 'draw';
      let oldTokens = resource.data.tokens;
      let proposedTokens = request.resource.data.tokens;
      let expectedTokens =
        battle.result == 'draw' ? oldTokens :
        isWinner ? oldTokens + battle.wager :
        isLoser ? (oldTokens - battle.wager > battle.token_floor ? oldTokens - battle.wager : battle.token_floor) :
        oldTokens;
      return battle.status == 'resolved'
        && requesterIsParticipant
        && targetIsParticipant
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tokens', 'last_daily_settlement'])
        && proposedTokens == expectedTokens;
    }

    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isPanelUser());
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /users/{userId} {
      // Broader than "owner or panel user" on purpose: the app's friend
      // search (searchUsersByName) and profile lookups let any signed-in
      // user read any other user's profile doc, not just admins.
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && (request.auth.uid == userId
            || isModerator()
            || isValidDailySettlement(userId));
      allow delete: if isModerator();

      match /saved_words/{word} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || isPanelUser());
        allow write: if request.auth != null
          && (request.auth.uid == userId || isModerator());
      }
      match /chat_history/{msg} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || isPanelUser());
        allow write: if request.auth != null
          && (request.auth.uid == userId || isModerator());
      }
      match /streak/{day} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || isPanelUser());
        allow write: if request.auth != null
          && (request.auth.uid == userId || isModerator());
      }
      match /progress/{doc} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || isPanelUser());
        allow write: if request.auth != null
          && (request.auth.uid == userId || isModerator());
      }
      match /topic_progress/{topicId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || isPanelUser());
        allow write: if request.auth != null
          && (request.auth.uid == userId || isModerator());
      }
      match /friends/{friendId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || isPanelUser());
        allow write: if request.auth != null
          && (request.auth.uid == userId || isModerator());
      }
      match /claimed_events/{eventId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || isPanelUser());
        allow write: if request.auth != null
          && (request.auth.uid == userId || isModerator());
      }
      match /gobot_usage/{date} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || isPanelUser());
        allow write: if request.auth != null
          && (request.auth.uid == userId || isModerator());
      }

      // Marks that this user has already claimed an event's one-time free
      // token top-up (so a live event grants it once, not every time the
      // app opens). Always a self-write, same as the tokens increment it
      // accompanies.
      match /event_topups/{eventId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || isPanelUser());
        allow write: if request.auth != null
          && (request.auth.uid == userId || isModerator());
      }

      // Tracks how many Daily Challenge attempts this user has used today
      // (doc id = calendar date), capping it at maxPlaysPerDay by rejecting
      // any increment once plays already hit 3 — the actual cap number is
      // duplicated here since rules can't reference the Dart constant.
      match /daily_challenge_history/{date} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || isPanelUser());
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.plays == 1;
        allow update: if request.auth != null
          && request.auth.uid == userId
          && resource.data.plays < 3
          && request.resource.data.plays == resource.data.plays + 1;

        // Refund: a claimed play whose queue attempt never became a real
        // match (cancelled or timed out with no opponent) is given back,
        // so abandoned attempts don't permanently cost one of today's 3.
        allow update: if request.auth != null
          && request.auth.uid == userId
          && resource.data.plays > 0
          && request.resource.data.plays == resource.data.plays - 1;
      }

      // Daily Challenge champion award, doc id = the event's id. Any
      // signed-in user's client may write this (not just userId
      // themselves) because it's set by whichever client happens to
      // notice the event ended — gated on that event's own champion_uid
      // (itself write-once, only settable after a real end_at) already
      // naming this exact userId, so it can't be forged for someone
      // who didn't actually win.
      match /badges/{eventId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (
          request.auth.uid == userId
          || isModerator()
          || (request.time > get(/databases/$(database)/documents/events/$(eventId)).data.end_at
              && get(/databases/$(database)/documents/events/$(eventId)).data.champion_uid == userId)
        );
      }
    }

    // Collection group queries (collectionGroup('saved_words'),
    // collectionGroup('chat_history')) need an explicit wildcard-path
    // rule — the nested rules above only cover direct reads of a known
    // user's subcollection.
    match /{path=**}/saved_words/{word} {
      allow read: if isPanelUser();
    }
    match /{path=**}/chat_history/{msg} {
      allow read: if isPanelUser();
    }

    match /friend_requests/{requestId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.from;
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to ||
        isPanelUser()
      );
      allow update: if isModerator();
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to ||
        isModerator()
      );
    }

    match /friendships/{friendshipId} {
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.users;
      // Broader than "participant only" on purpose, same reasoning as
      // users/{userId}'s read rule: viewing another profile's friend count
      // (getFriendsCountFor) queries this collection filtered by THAT
      // person's uid, not the caller's — a query shape Firestore can only
      // prove safe when the array-contains value is request.auth.uid
      // itself, so a participant-only rule silently denies the query for
      // anyone looking at someone else's profile.
      allow read: if request.auth != null;
      allow delete: if request.auth != null && (
        request.auth.uid in resource.data.users ||
        isModerator()
      );
    }

    match /bonds/{bondId} {
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.users ||
        isPanelUser()
      );
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.users;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.users ||
        isModerator()
      );
    }

    match /config/{doc} {
      // Public read: feature flags (e.g. registrationEnabled) must be
      // checkable before sign-in/sign-up.
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Home-screen "last event champion" banner. Unlike the generic
    // config rule above, any signed-in user can write this — it's set
    // by whichever client happens to notice a live event has ended and
    // computes who won the most Daily Challenge battles, since there's
    // no Cloud Function to run that check on a schedule. Only WHICH
    // event is referenced and that it has genuinely ended is
    // rules-verifiable; who actually won the most is a client-side
    // tally, the same disclosed trade-off as the rest of this file.
    match /config/last_champion {
      allow read: if true;
      allow write: if isSuperAdmin() || (
        request.auth != null
        && request.resource.data.event_id is string
        && request.time > get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.end_at
        && get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.champion_uid == request.resource.data.uid
      );
    }

    // Users can submit feedback/bug reports but cannot read, edit, or
    // delete any entry (including their own); the admin panel can read.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow read: if isPanelUser();
      allow update, delete: if false;
    }

    match /scan_history/{scanId} {
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.user_id == request.auth.uid ||
        isPanelUser()
      );
      allow update, delete: if isModerator();
    }

    // Site-wide scan counters (word -> how many times anyone has scanned
    // it), used for the Home screen's "Popular Now" list. Readable by any
    // signed-in user; writable only as a strict +1 to scan_count, so a
    // client can bump the counter but can never set it to an arbitrary
    // value.
    match /word_stats/{word} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.word == word
        && request.resource.data.scan_count == 1;
      allow update: if request.auth != null
        && request.resource.data.word == word
        && request.resource.data.scan_count == resource.data.scan_count + 1;
      allow delete: if false;
    }

    // Topic content (name, icon, color, position, word list), read by every
    // signed-in user. `create` is only open so the app's one-time seed
    // (FirestoreService.seedTopicsOnce) can populate this collection from
    // an empty database; existing topic docs can never be changed or
    // removed by a client afterward. Add/edit topics and words later
    // through the Firebase Console or admin panel, not through the app.
    match /topics/{topicId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isModerator();
    }

    // Admin-panel-only drafts of topics (new topics or pending edits to a
    // published one). The app never reads this collection.
    match /topic_drafts/{topicId} {
      allow read: if isPanelUser();
      allow write: if isModerator();
    }

    match /events/{eventId} {
      allow read: if request.auth != null;
      // champion_uid is write-once, only after the event has genuinely
      // ended (request.time is real, not client-suppliable) — WHICH uid
      // actually won the most is a client-side tally with no Cloud
      // Function to verify it, the same disclosed trade-off as the rest
      // of this file's client-trusted writes.
      allow update: if isModerator() || (
        request.auth != null
        && resource.data.champion_uid == null
        && request.time > resource.data.end_at
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['champion_uid'])
        && request.resource.data.champion_uid is string
      );
      allow create, delete: if isModerator();

      // Admin-curated vocabulary for that calendar day's Daily
      // Challenge — one doc per word (not an array) so a battle round
      // (below) can validate its options/correct_index against the
      // exact real word via a single get(), instead of trusting
      // whichever client creates the round.
      match /daily_challenges/{date}/words/{index} {
        allow read: if request.auth != null;
        allow write: if isModerator();
      }
    }

    // ============================================================
    // DAILY CHALLENGE
    // ============================================================

    // One entry per waiting user; matched by the next person who also
    // wants that same event+day's challenge.
    match /daily_challenge_queue/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.event_id is string
        && request.resource.data.challenge_date is string;

      // You may change/cancel your own entry freely; someone else may
      // only flip your still-waiting entry to matched, pointing at a
      // battle they are creating with you.
      allow update: if request.auth != null && (
        request.auth.uid == uid
        || (resource.data.status == 'waiting'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'matched_with', 'battle_id'])
            && request.resource.data.status == 'matched'
            && request.resource.data.matched_with == request.auth.uid)
      );

      allow delete: if request.auth != null
        && (request.auth.uid == uid || isModerator());
    }

    match /daily_battles/{battleId} {
      // Broader than a typical private-match read on purpose:
      // Daily Challenge is a public competitive event whose results
      // feed the end-of-event champion tally, which a regular user's
      // client has to compute itself (no Cloud Function) by reading
      // every battle for that event — not just their own.
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && (request.auth.uid == request.resource.data.player_a_uid
            || request.auth.uid == request.resource.data.player_b_uid)
        && request.resource.data.player_a_uid != request.resource.data.player_b_uid
        && request.resource.data.event_id is string
        && request.resource.data.challenge_date is string
        && request.resource.data.status == 'active'
        && request.resource.data.result == null
        && request.resource.data.settled == false
        && request.resource.data.player_a_score == null
        && request.resource.data.player_b_score == null
        && request.resource.data.wager is int && request.resource.data.wager > 0
        && request.resource.data.token_floor is int && request.resource.data.token_floor >= 0
        && request.resource.data.round_count is int && request.resource.data.round_count > 0;

      // Resolution: totals two already-locked-in per-round scores into
      // a result — the per-round correctness feeding those scores was
      // itself validated by each round's own rules below.
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.player_a_uid || request.auth.uid == resource.data.player_b_uid)
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'result', 'player_a_score', 'player_b_score', 'resolved_at'])
        && request.resource.data.status == 'resolved'
        && request.resource.data.player_a_score is int
        && request.resource.data.player_b_score is int
        && request.resource.data.result == dailyBattleExpectedResult(request.resource.data.player_a_score, request.resource.data.player_b_score)
        && request.resource.data.resolved_at == request.time;

      // Settling tokens: settled false -> true exactly once.
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.player_a_uid || request.auth.uid == resource.data.player_b_uid)
        && resource.data.status == 'resolved'
        && resource.data.settled == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settled'])
        && request.resource.data.settled == true;

      allow delete: if false;

      match /rounds/{index} {
        allow read: if request.auth != null
          && (dailyBattleParticipant(battleId) || isPanelUser());

        allow create: if request.auth != null
          && dailyBattleParticipant(battleId)
          && request.resource.data.source_index is int
          && request.resource.data.source_index >= 0
          && dailyRoundMatchesSource(battleId)
          && request.resource.data.player_a_choice == null
          && request.resource.data.player_b_choice == null;

        allow update: if request.auth != null && (
          (dailyBattleParticipant(battleId)
            && get(/databases/$(database)/documents/daily_battles/$(battleId)).data.player_a_uid == request.auth.uid
            && resource.data.player_a_choice == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['player_a_choice', 'player_a_answered_at', 'player_a_elapsed_ms'])
            && request.resource.data.player_a_choice is int
            && request.resource.data.player_a_choice >= 0 && request.resource.data.player_a_choice < 4
            && request.resource.data.player_a_elapsed_ms is int && request.resource.data.player_a_elapsed_ms >= 0
            && request.resource.data.player_a_answered_at == request.time)
          ||
          (dailyBattleParticipant(battleId)
            && get(/databases/$(database)/documents/daily_battles/$(battleId)).data.player_b_uid == request.auth.uid
            && resource.data.player_b_choice == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['player_b_choice', 'player_b_answered_at', 'player_b_elapsed_ms'])
            && request.resource.data.player_b_choice is int
            && request.resource.data.player_b_choice >= 0 && request.resource.data.player_b_choice < 4
            && request.resource.data.player_b_elapsed_ms is int && request.resource.data.player_b_elapsed_ms >= 0
            && request.resource.data.player_b_answered_at == request.time)
        );

        allow delete: if false;
      }
    }

    match /announcements/{announcementId} {
      allow read: if isPanelUser();
      allow write: if isModerator();
    }

    // Not written by the app yet — read-only placeholders for the admin
    // panel until those features exist. Tighten write once they do.
    match /flagged/{id} {
      allow read: if isPanelUser();
      allow write: if false;
    }

    match /subscriptions/{id} {
      allow read: if isPanelUser();
      allow write: if false;
    }

    // Purchase history for the admin panel's Subscription page. Not written by
    // the app yet; should only ever be written server-side after payment
    // verification, never by a client.
    match /purchases/{id} {
      allow read: if isPanelUser();
      allow write: if false;
    }

    match /words/{wordId} {
      allow read: if isPanelUser();
      allow write: if isModerator();
    }
  }
}
